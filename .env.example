# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=sat
POSTGRES_USER=sat_user
POSTGRES_PASSWORD=replace_with_strong_password

# ── Backend secrets ────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_different_long_random_string

# ── CORS origin ────────────────────────────────────────────────────────────────
# Set to your VPS IP (or domain once you have one, including http/https)
# Example: http://1.2.3.4  or  https://example.com
FRONTEND_URL=http://YOUR_VPS_IP

# ── Public base URL ────────────────────────────────────────────────────────────
# Used to build absolute URLs for uploaded files (images, documents, etc.)
# Must include the path prefix if the app is served under a sub-path.
# Example (standalone domain): https://example.com
# Example (sub-path, current setup): https://mocktest.niec.edu.np/sat
PUBLIC_BASE_URL=https://mocktest.niec.edu.np/sat

# ── AI features (optional) ────────────────────────────────────────────────────
# Leave blank to disable AI features
OPENROUTER_API_KEY=
AI_MODEL_FEEDBACK=
AI_MODEL_NARRATIVE=
AI_MODEL_CLASSIFY=
