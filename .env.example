# ─────────────────────────────────────────────────────────────────────────────
# docker-compose configuration — copy to .env at the repo root.
#
# This file configures the *Postgres container only*. docker-compose reads it
# for ${...} interpolation in docker-compose.yml.
#
# The backend does NOT read this file. Compose passes it backend/.env instead
# (see the `env_file:` key), so DATABASE_URL, the JWT secrets, FRONTEND_URL and
# the AI keys all live in backend/.env — putting them here has no effect.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_DB=sat
POSTGRES_USER=sat_user
POSTGRES_PASSWORD=replace_with_strong_password

# These three must agree with DATABASE_URL in backend/.env, where the host is
# the compose service name `db`:
#   DATABASE_URL=postgresql://sat_user:replace_with_strong_password@db:5432/sat
