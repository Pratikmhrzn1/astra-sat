# ─────────────────────────────────────────────────────────────────────────────
# Backend configuration — copy to backend/.env and fill in.
#
# This file is the application's configuration. The .env at the repo root is a
# *different* file: it only feeds docker-compose (the Postgres container's
# credentials). Compose hands this file to the backend container verbatim via
# `env_file`, so anything the server reads belongs HERE, not there.
#
# Every variable is validated at boot by src/config/env.ts. A missing required
# value stops the server with an explanatory message instead of failing later.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Postgres connection string.
#   local:  postgresql://sat_user:password@localhost:5432/sat
#   docker: postgresql://sat_user:password@db:5432/sat   ← host is the compose
#           service name, and the credentials must match the root .env
#   hosted: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://sat_user:password@localhost:5432/sat

# Token signing secrets. Generate each with:  openssl rand -base64 48
# They must differ from each other — if they match, a leaked access token can
# be replayed as a refresh token. 32+ characters; the server warns below that.
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── HTTP ─────────────────────────────────────────────────────────────────────

# Allowed CORS origin(s), comma-separated. Credentials are always sent, so '*'
# is not valid here. Include the scheme, and no trailing slash.
#   dev:  http://localhost:5173
#   prod: https://mocktest.niec.edu.np
FRONTEND_URL=http://localhost:5173

# Absolute base URL used to turn stored /uploads/... paths into full URLs in API
# responses and emails. Include the sub-path if the app is served under one.
# Leave unset in local dev — paths are then returned unchanged.
# PUBLIC_BASE_URL=https://mocktest.niec.edu.np/sat

PORT=3001
NODE_ENV=development

# Forces the refresh cookie's `secure` flag. Defaults to on when NODE_ENV is
# production, off otherwise — only set this to override that.
# COOKIE_SECURE=false

# Where uploaded files are written. Defaults to <cwd>/uploads. In production
# this must point at a mounted volume, or uploads vanish on redeploy.
# UPLOAD_DIR=/app/uploads

# ── AI features (optional) ───────────────────────────────────────────────────
# Without OPENROUTER_API_KEY every AI feature is skipped, and the app still
# works — practice, mocks and grading are unaffected. Each model variable is
# also an independent switch: unset AI_MODEL_NARRATIVE and no post-test
# narratives are generated, with no other effect.

OPENROUTER_API_KEY=
# Per-question confirm feedback — high volume, use a fast/cheap model.
AI_MODEL_FEEDBACK=anthropic/claude-haiku-4.5
# Post-test diagnostic narratives and generated skill passages — low volume.
AI_MODEL_NARRATIVE=anthropic/claude-sonnet-5
# Batch sub-skill classification of untagged questions — admin-triggered.
AI_MODEL_CLASSIFY=anthropic/claude-sonnet-5

# ── Transactional email (Resend) ─────────────────────────────────────────────
# Signup sends a verification link, and an account cannot sign in until it is
# verified AND approved by an admin — so in production this is effectively
# required. Without a key, every email (verification, password reset, account
# approved) is printed to the server console instead of sent: fine for dev.

RESEND_API_KEY=
# Must be on a domain verified in your Resend account. Either a bare address,
# or a full sender such as: SAT Prep <noreply@mocktest.niec.edu.np>
RESEND_FROM=noreply@mocktest.niec.edu.np

# Links in emails point at PUBLIC_BASE_URL (above), or at the first FRONTEND_URL
# origin + /sat when that is unset.

# ── Account security (optional — these are the defaults) ────────────────────
# How long a verification / password-reset link stays valid (m, h or d).
# EMAIL_VERIFICATION_TTL=24h
# PASSWORD_RESET_TTL=1h
# Consecutive wrong passwords before the account is locked, and for how long.
# Persisted on the user row; an admin can unlock early from User Management.
# LOGIN_MAX_FAILED_ATTEMPTS=10
# LOGIN_LOCKOUT_MINUTES=15

# ── Account defaults (optional) ──────────────────────────────────────────────
# Seed values for Admin → Platform settings, used only when that settings row is
# first created. After that, change them in the admin UI, not here.
# Trial: access window and test starts per Nepal calendar day. Student: access
# window. Both count from the signup date.
# TRIAL_DURATION_DAYS=14
# TRIAL_DAILY_TEST_LIMIT=5
# STUDENT_DURATION_DAYS=60

# ── Seed accounts (optional; used only by `npm run seed`) ────────────────────
# Bootstrap logins for a fresh database — a public signup needs an admin to
# approve it, and an empty database has none. Seeded accounts are created
# active and verified. Read only by the seed
# script, never at runtime, so these can be left unset on a server.
#
# Seeding is idempotent: re-running resets these accounts to the values here,
# which doubles as the recovery path for a forgotten local password.
# The password must satisfy the same rule as registration (8+ characters).

# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Admin

# SEED_STUDENT_EMAIL=student@example.com
# SEED_STUDENT_PASSWORD=
# SEED_STUDENT_NAME=Student
