DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change-this-to-a-long-random-secret-string-min-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-also-min-32-chars
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Leave unset in local dev — only needed in production to build correct upload URLs
# PUBLIC_BASE_URL=https://yourdomain.com/sat
# Defaults to <cwd>/uploads — override to persist uploads outside the container
# UPLOAD_DIR=/var/uploads/sat
# Set to 'false' to disable secure cookies (e.g. local dev over http). Defaults to true in production.
# COOKIE_SECURE=false
OPENROUTER_API_KEY=
AI_MODEL_FEEDBACK=anthropic/claude-haiku-4.5
AI_MODEL_NARRATIVE=anthropic/claude-sonnet-4.6
AI_MODEL_CLASSIFY=anthropic/claude-sonnet-4.6
# Resend transactional email — leave unset in local dev to skip email sending
RESEND_API_KEY=
RESEND_FROM=noreply@mocktest.niec.edu.np
