{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  // src/routes and src/middleware are the pre-rewrite implementation, kept in
  // the tree only as a reference while modules are ported. They are superseded
  // by src/modules and src/http, and are deleted once the port is complete.
  "exclude": ["node_modules", "dist", "src/routes", "src/middleware"]
}
